# Environment
.env
.env.local
.env.*.local

# Application data (contents ignored, directory structure tracked via .gitkeep)
app/wordpress/db_data/
app/wordpress/db_data_mariadb/**
!app/wordpress/db_data_mariadb/.gitkeep
app/wordpress/wordpress_data/**
!app/wordpress/wordpress_data/.gitkeep
app/log_data/**
!app/log_data/db_logs/
!app/log_data/db_logs/.gitkeep
!app/log_data/wordpress_logs/
!app/log_data/wordpress_logs/.gitkeep

# Platform runtime
platform/log_data/**
!platform/log_data/nginx_logs/
!platform/log_data/nginx_logs/.gitkeep
platform/nginx_data/certs/
platform/nginx_data/html/
platform/nginx_data/conf.d/*.conf

# Temporary
/work

# Personal blog content (spec/design/ops notes, not part of the WordPress setup itself)
/docs/
/design/
/platform/docs/
/history.md

# Local backups / working copies (may contain live secrets - never commit)
*.bak
*.bak.*
app/backup/

# Demo apps (personal deployments layered on top of the base WordPress stack,
# not part of the "set up WordPress" repo itself)
/app/docker_*/
/platform/docker-compose.demo.yml
/platform/scripts/create-blog-posts.php
/platform/scripts/expo-control-watcher.sh
/platform/scripts/expo-demo.sh
/platform/scripts/gen-expo-branding.py

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Node (if needed)
node_modules/
npm-debug.log

# Docker
.docker/