# =============================================================================
# Demo app subdomain template
# =============================================================================
#
# 使い方:
#   1. このファイルを platform/nginx_data/conf.d/<sub>.conf にコピー
#      例) cp demo-app.conf.template ../nginx_data/conf.d/todo.conf
#   2. 下記プレースホルダを置換
#        __SUBDOMAIN__   ... 公開する FQDN (例: todo.example.com)
#        __SERVICE__     ... compose の service 名 (例: demo-todo)
#        __PORT__        ... サービスの内部リッスンポート (例: 3000)
#   3. docker compose restart nginx で反映
#
# 注意:
#   - 既存の owasp/modsecurity-crs:nginx は 8080 / 8443 を listen している。
#   - ホスト側は docker-compose.yml の `ports: 80:8080, 443:8443` で公開済み。
#   - 同じファイル内に 80/443 (host) -> 8080/8443 (container) 用の server を書く。
#   - SSL 証明書は certbot で /etc/nginx/certs/__SUBDOMAIN__/{fullchain,privkey}.pem
#     に格納される想定 (ホスト: ./nginx_data/certs/)。
#     ローカル検証時は自己署名証明書でも OK。

# ----- HTTP (80) : Let's Encrypt 取得用 + HTTPS リダイレクト -----
server {
    listen 8080;
    server_name __SUBDOMAIN__;

    # Let's Encrypt webroot
    location /.well-known/acme-challenge/ {
        root /usr/share/nginx/html;
    }

    # 公開運用時は HTTPS にリダイレクト
    location / {
        return 301 https://$host$request_uri;
    }
}

# ----- HTTPS (443) : リバースプロキシ本体 -----
server {
    listen 8443 ssl;
    http2 on;
    server_name __SUBDOMAIN__;

    # certbot で取得した証明書 (なければ nginx 起動失敗するのでコメントアウトして検証)
    ssl_certificate     /etc/nginx/certs/live/__SUBDOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/live/__SUBDOMAIN__/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:DemoSSL:10m;

    # WAF (ModSecurity CRS) を継承
    modsecurity on;

    # WebSocket 用 (不要なら削除)
    location / {
        client_max_body_size 16m;

        proxy_pass         http://__SERVICE__:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        $connection_upgrade;
        proxy_set_header   Accept-Encoding   "";   # sub_filter に必要
        proxy_read_timeout 60s;
    }

    # ポートフォリオへ戻るナビゲーションバーを全 HTML レスポンスに注入
    include /etc/nginx/conf.d/demo-banner.inc;
}
