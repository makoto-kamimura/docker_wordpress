# =====================================================================
# docker_wordpress 環境変数テンプレート
# 実運用時は ./platform/.env に複製して値を埋める (.env は git 管理外)
# =====================================================================

# ---- 公開ドメイン / 連絡先 -----------------------------------------
# Let's Encrypt 証明書を取得するドメイン
PUBLIC_DOMAIN=example.com

# Let's Encrypt の連絡先メール (有効期限通知に使用)
LETSENCRYPT_EMAIL=admin@example.com

# ---- DB (MariaDB) ---------------------------------------------------
# 強パスワード推奨: openssl rand -base64 32 | tr -d '/+=' | cut -c1-40
MYSQL_ROOT_PASSWORD=change-me-strong-root-password
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_app
MYSQL_PASSWORD=change-me-strong-app-password

# ---- WordPress ------------------------------------------------------
# WP_TABLE_PREFIX は wp_ 以外に変更しておくと自動化攻撃に対する耐性が上がる
WP_TABLE_PREFIX=wpkk_

# ---- WordPress Salt キー (公開直前に必ず再生成) --------------------
# 再生成:
#   for k in WP_AUTH_KEY WP_SECURE_AUTH_KEY WP_LOGGED_IN_KEY WP_NONCE_KEY \
#            WP_AUTH_SALT WP_SECURE_AUTH_SALT WP_LOGGED_IN_SALT WP_NONCE_SALT; do
#     printf "%s=%s\n" "$k" "$(LC_ALL=C tr -dc 'A-Za-z0-9!@#%^*()_+=-' </dev/urandom | head -c 64)"
#   done
WP_AUTH_KEY=change-me-64char-random
WP_SECURE_AUTH_KEY=change-me-64char-random
WP_LOGGED_IN_KEY=change-me-64char-random
WP_NONCE_KEY=change-me-64char-random
WP_AUTH_SALT=change-me-64char-random
WP_SECURE_AUTH_SALT=change-me-64char-random
WP_LOGGED_IN_SALT=change-me-64char-random
WP_NONCE_SALT=change-me-64char-random

# ---- Redis (オブジェクトキャッシュ) --------------------------------
REDIS_PASSWORD=change-me-redis-password

# ---- SMTP (WP Mail SMTP, 未設定なら initial-setup.sh はスキップ) ----
# 例: Amazon SES (ap-northeast-1)
#   SMTP_HOST=email-smtp.ap-northeast-1.amazonaws.com
#   SMTP_PORT=587
#   SMTP_ENCRYPTION=tls          # tls | ssl | none
#   SMTP_AUTH=1                  # 0 | 1
#   SMTP_USER=AKIA...
#   SMTP_PASS=change-me
#   SMTP_FROM_EMAIL=no-reply@example.com
#   SMTP_FROM_NAME=Makoto Kamimura
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_AUTH=1
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# ---- phpMyAdmin (profile=admin で起動した時のみ使用) ---------------
# `docker compose --profile admin up -d phpmyadmin` の時だけ立ち上がる
# ホスト側 127.0.0.1:8888 にのみバインド
PMA_USER=wp_app
PMA_PASSWORD=change-me-pma-password

# ---- リソース上限 (環境に応じて調整) -------------------------------
WP_MEM_LIMIT=512m
DB_MEM_LIMIT=512m
NGINX_MEM_LIMIT=256m

# ---- n8n (profile=automation で起動した時のみ使用) ------------------
# `docker compose --profile automation up -d n8n` の時だけ立ち上がる
# ホスト側 127.0.0.1:5678 にのみバインド。詳細は platform/n8n/README.md
#
# N8N_ENCRYPTION_KEY: n8n が保存する認証情報の暗号化キー
#   生成: openssl rand -hex 32
#   - 一度決めたら変えない (変えると登録済みの認証情報が復号できなくなる)
#   - 未設定だと n8n が自前で生成してボリューム内に保存するため、
#     バックアップや再作成のたびに食い違う。ここで固定しておく
N8N_ENCRYPTION_KEY=
N8N_MEM_LIMIT=768m

# 運用ダイジェスト / WAF アラートの宛先。
# 空のままだと n8n の 2 つの通知ワークフロー (運用ダイジェスト・WAF 閾値アラート)
# はメールを送れない。MCP ツール側は宛先が無くても動く。
# 送信には上の SMTP_* も必要 (WordPress 用の設定をそのまま使い回す)。
OPS_ALERT_EMAIL_TO=

# WAF 閾値アラートの感度 (n8n の「閾値判定」ノードが参照)
#   THRESHOLD: 1 時間に同一 IP から何件遮断されたら通知するか
#              まずは既定値で運用し、メールが多すぎる / 少なすぎる場合に調整する
#   COOLDOWN : 同じ IP を何時間は再通知しないか
#              スキャナは数日居座るため、短くすると同じ内容が毎時間届く
WAF_ALERT_THRESHOLD=30
WAF_ALERT_COOLDOWN_HOURS=6
