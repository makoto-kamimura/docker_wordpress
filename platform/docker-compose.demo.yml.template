# =============================================================================
# Demo apps override — docker-compose.demo.yml.template
# =============================================================================
#
# 「Works に載せる実稼働デモ」を追加するためのテンプレート。
#
# 使い方:
#   1. このファイルを docker-compose.demo.yml としてコピー
#        cp docker-compose.demo.yml.template docker-compose.demo.yml
#   2. 下の `demo-todo` / `demo-static` ブロックを参考にサービスを追加・編集
#   3. 起動
#        docker compose -f docker-compose.yml -f docker-compose.demo.yml up -d
#   4. Nginx 側に platform/nginx_conf/conf.d/demo-app.conf.template から
#      <sub>.conf を生成し、サブドメインを公開
#
# ポリシー:
#   - デモコンテナはホスト側ポートを公開しない (ports: は書かない)。
#     Nginx (proxy_network 経由) から内部 DNS で名前解決して接続する。
#   - 必ず networks: に proxy_network を含める。
#   - データを永続化したい場合は volumes でホスト側にバインドする。
#   - 1サービス1作品。Work CPT の Demo URL に対応する FQDN を設定する。

services:

  # ---------------------------------------------------------------------------
  # 例 1: Node.js / 自前イメージ (例: TODO アプリ)
  # ---------------------------------------------------------------------------
  demo-todo:
    # 自前 Dockerfile を使う場合:
    # build:
    #   context: ../app/demo-todo
    #   dockerfile: Dockerfile
    image: node:20-alpine
    working_dir: /app
    command: ["sh", "-c", "echo 'replace me' && tail -f /dev/null"]
    # ホスト側ポートは公開しない (Nginx 経由のみ)
    expose:
      - "3000"
    environment:
      NODE_ENV: production
    volumes:
      - ../app/demo-todo:/app
    restart: unless-stopped
    networks:
      - proxy_network

  # ---------------------------------------------------------------------------
  # 例 2: 静的サイト (LP / 資料 / Vite ビルド成果物 など)
  # ---------------------------------------------------------------------------
  demo-static:
    image: nginx:alpine
    expose:
      - "80"
    volumes:
      - ../app/demo-static:/usr/share/nginx/html:ro
    restart: unless-stopped
    networks:
      - proxy_network

  # ---------------------------------------------------------------------------
  # 例 3: 既存イメージをそのまま使う (例: n8n, Grafana, etc.)
  # ---------------------------------------------------------------------------
  # demo-foo:
  #   image: vendor/foo:latest
  #   expose:
  #     - "8080"
  #   environment:
  #     FOO_BAR: baz
  #   volumes:
  #     - ../app/demo-foo:/data
  #   restart: unless-stopped
  #   networks:
  #     - proxy_network

networks:
  # ベース compose で定義済みのネットワークを外部参照
  proxy_network:
    external: true
    name: docker_wordpress_proxy_network
